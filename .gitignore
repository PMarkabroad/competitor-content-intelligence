.env
__pycache__/
*.pyc
.venv/
# Root-anchored (was a bare "data/" -- matched any directory named "data"
# at any depth, which silently swallowed the dashboard's app/(app)/data/
# route folder. This was always meant to be the top-level Python scaffold
# data directory, not a generic pattern.
/data/

# competitor-pipeline (TypeScript)
competitor-pipeline/node_modules/
competitor-pipeline/dist/
competitor-pipeline/logs/*.log
competitor-pipeline/out/*
# ...except the monthly hook report itself -- a real deliverable (read by a
# designer/content producer), not a transient scratch/debug artifact like
# the rest of out/. (Must exclude contents via /out/* rather than /out/ --
# git can't re-include a file whose parent directory is itself excluded.)
!competitor-pipeline/out/hook_report_*.md

# Supabase CLI local cache (project ref, pooler URL, DB host -- infra metadata, not source)
supabase/.temp/

# Claude Code harness-internal state, not project source
.claude/
