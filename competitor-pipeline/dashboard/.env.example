# Server-side only. Never prefix with NEXT_PUBLIC_ -- these must never
# reach the browser bundle.

# Same Supabase project as the pipeline's own competitor-pipeline/.env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Shared password for the three-person internal tool. No user accounts.
DASHBOARD_PASSWORD=choose-a-password

# Same Apify token as competitor-pipeline/.env. Used only by /status to
# show real month-to-date spend. Optional -- /status degrades to "spend
# unavailable" without it, nothing else needs it.
APIFY_TOKEN=your-apify-token

# Must match MONTHLY_APIFY_SPEND_CAP_USD in competitor-pipeline/config.ts
# by hand -- the dashboard is deployed as its own isolated Vercel project
# (only this directory is uploaded), so it can't import that file
# directly the way the CLI's scripts/ can. Optional -- /status shows
# spend without a cap bar if unset.
MONTHLY_APIFY_SPEND_CAP_USD=15
